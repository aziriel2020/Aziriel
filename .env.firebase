# ========================================
# FIREBASE ENVIRONMENT VARIABLES
# ========================================
# Copy this to Firebase Functions config:
# firebase functions:config:set key="value"

# REQUIRED - Database
DATABASE_URL="file:./server/prisma/dev.db"
# For production, use PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/neurafield"

# REQUIRED - Redis Cache
REDIS_URL="redis://localhost:6379"
# For production Redis:
# REDIS_URL="redis://user:password@host:6379"

# REQUIRED - JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# OPTIONAL - Client URL
CLIENT_URL="https://neurafield-quantum.web.app"

# ========================================
# AI API KEYS (Optional - Add as needed)
# ========================================

# OpenAI (for Sora 2.0, DALL-E)
OPENAI_API_KEY="sk-..."

# Google AI (for Veo 3.1, Gemini)
GOOGLE_AI_API_KEY="..."

# Anthropic (for Claude)
ANTHROPIC_API_KEY="sk-ant-..."

# Runway (for Gen-4.5)
RUNWAY_API_KEY="..."

# Replicate (for various models)
REPLICATE_API_TOKEN="..."

# ========================================
# AUDIO AI KEYS (Optional)
# ========================================

# Suno AI (music generation)
SUNO_API_KEY="..."

# ElevenLabs (voice-over)
ELEVENLABS_API_KEY="..."

# ========================================
# PAYMENT (Optional - for subscriptions)
# ========================================

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ========================================
# STORAGE (Optional - for S3 uploads)
# ========================================

# AWS S3
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_S3_BUCKET="neurafield-videos"
AWS_REGION="us-east-1"

# ========================================
# HOW TO SET IN FIREBASE
# ========================================
#
# Method 1: Firebase CLI
# firebase functions:config:set database.url="your-value"
# firebase functions:config:set redis.url="your-value"
# firebase functions:config:set jwt.secret="your-value"
#
# Method 2: Firebase Console
# Go to: Firebase Console > Functions > Configuration
# Add environment variables there
#
# Method 3: .env file (for local emulator)
# Create .env file in root with these variables
# firebase emulators:start --only functions
