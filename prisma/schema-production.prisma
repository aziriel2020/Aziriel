// NEURAFIELD QUANTUM - COMPLETE PRODUCTION DATABASE SCHEMA
// ==========================================================
// $10B+ Platform - Full Production-Ready Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT & AUTHENTICATION
// ============================================================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String?   @unique
  passwordHash      String?   // bcrypt hash
  firstName         String?
  lastName          String?
  displayName       String?   // For ActivityPub
  avatar            String?
  avatarUrl         String?   // For ActivityPub
  bannerUrl         String?   // For ActivityPub
  bio               String?

  // Email Verification
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  emailVerificationToken String?

  // Password Reset
  passwordResetToken String?
  passwordResetExpires DateTime?

  // Two-Factor Authentication
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?   // TOTP secret
  twoFactorBackupCodes String[] // Backup codes

  // OAuth Providers
  googleId          String?   @unique
  githubId          String?   @unique
  discordId         String?   @unique
  twitterId         String?   @unique

  // ActivityPub (Federation)
  publicKey         String?   @db.Text // RSA public key for ActivityPub
  privateKey        String?   @db.Text // RSA private key for ActivityPub signatures

  // Subscription & Billing
  stripeCustomerId  String?   @unique
  subscriptionTier  SubscriptionTier @default(FREE)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionId    String?
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  trialEndsAt       DateTime?

  // Credits & Usage
  credits           Int       @default(100)
  creditsUsed       Int       @default(0)
  monthlyQuota      Int?      // Based on tier

  // Account Status
  role              UserRole  @default(USER)
  status            UserStatus @default(ACTIVE)
  suspendedAt       DateTime?
  suspendedReason   String?
  deletedAt         DateTime?

  // Activity Tracking
  lastLoginAt       DateTime?
  lastActivityAt    DateTime?
  loginCount        Int       @default(0)

  // Preferences
  preferences       Json?     // UI settings, notifications, etc.
  timezone          String?   @default("UTC")
  language          String?   @default("en")

  // Metadata
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  apiKeys           ApiKey[]
  sessions          Session[]
  projects          Project[]
  videos            Video[]
  jobs              Job[]
  socialAccounts    SocialAccount[]
  teams             TeamMember[]
  ownedTeams        Team[]
  auditLogs         AuditLog[]
  usage             UsageRecord[]
  payments          Payment[]
  invoices          Invoice[]
  notifications     Notification[]
  webhooks          Webhook[]
  assets            Asset[]
  collections       Collection[]

  @@index([email])
  @@index([username])
  @@index([stripeCustomerId])
  @@index([subscriptionTier])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  USER
  CREATOR
  PRO
  STUDIO
  ENTERPRISE
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
  PENDING_VERIFICATION
}

enum SubscriptionTier {
  FREE
  CREATOR
  PRO
  STUDIO
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
  PAUSED
}

// ============================================================================
// AUTHENTICATION & SECURITY
// ============================================================================

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token        String   @unique @db.Text
  refreshToken String?  @unique @db.Text

  expiresAt    DateTime
  refreshExpiresAt DateTime?

  // Session metadata
  ipAddress    String?
  userAgent    String?
  deviceId     String?
  location     Json?    // GeoIP data

  // Status
  isActive     Boolean  @default(true)
  revokedAt    DateTime?
  lastActivityAt DateTime @default(now())

  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  key         String   @unique @db.Text // Hashed
  prefix      String   // First 8 chars for identification

  // Permissions & Limits
  scopes      String[] // Array of allowed scopes
  rateLimit   Int?     // Requests per minute

  // Status
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  usageCount  Int      @default(0)

  expiresAt   DateTime?
  revokedAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([key])
  @@index([prefix])
  @@map("api_keys")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String   // login, logout, video_generate, etc.
  resource    String   // user, video, payment, etc.
  resourceId  String?

  // Request details
  method      String?  // GET, POST, etc.
  path        String?

  // Result
  status      String?  // success, failure
  statusCode  Int?     // HTTP status

  // Context
  ipAddress   String?
  userAgent   String?
  location    Json?

  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// TEAMS & ORGANIZATIONS
// ============================================================================

model Team {
  id              String       @id @default(uuid())
  ownerId         String
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name            String
  slug            String       @unique
  avatar          String?
  description     String?

  // Subscription
  subscriptionTier SubscriptionTier @default(FREE)
  stripeCustomerId String?     @unique

  // Settings
  settings        Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  members         TeamMember[]
  projects        Project[]

  @@index([slug])
  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      TeamRole @default(MEMBER)

  invitedBy String?
  invitedAt DateTime?
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
  COMMENTER
}

// ============================================================================
// PROJECTS, VIDEOS & ASSETS
// ============================================================================

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  name        String
  description String?
  thumbnail   String?
  type        String?  @default("other") // short-film, commercial, music-video, social

  // Organization
  folderId    String?
  tags        String[]

  // Flow Studio
  storyboard  Json?    // Storyboard data
  timelineId  String?  // Reference to Timeline
  collaborators String[] // User IDs with access
  status      String?  @default("draft") // draft, in-progress, rendering, completed

  // Settings
  settings    Json?
  metadata    Json?

  // Status
  isPublic    Boolean  @default(false)
  isArchived  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  videos      Video[]
  assets      Asset[]

  @@index([userId])
  @@index([teamId])
  @@index([isArchived])
  @@map("projects")
}

model Video {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title         String
  description   String?     @db.Text

  // File information
  url           String?
  thumbnailUrl  String?
  duration      Float?      // seconds
  resolution    String?     // 1920x1080
  width         Int?
  height        Int?
  fps           Int?
  fileSize      BigInt?     // bytes
  format        String?     // mp4, mov
  codec         String?     // h264, h265

  // Generation metadata
  provider      String?     // sora, runway, veo, etc.
  model         String?
  prompt        String?     @db.Text
  negativePrompt String?    @db.Text
  seed          Int?
  settings      Json?

  // Processing
  status        VideoStatus @default(PROCESSING)
  progress      Int         @default(0)
  error         String?     @db.Text

  // Visibility & Permissions
  visibility    Visibility  @default(PRIVATE)
  password      String?     // For password-protected videos

  // Analytics
  views         Int         @default(0)
  downloads     Int         @default(0)

  // Metadata
  metadata      Json?
  exifData      Json?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  publishedAt   DateTime?
  deletedAt     DateTime?

  jobs          Job[]
  clips         Clip[]
  versions      VideoVersion[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@map("videos")
}

enum VideoStatus {
  QUEUED
  PROCESSING
  TRANSCODING
  COMPLETED
  FAILED
  CANCELED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
  TEAM
  PASSWORD_PROTECTED
}

model VideoVersion {
  id          String   @id @default(uuid())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  version     Int
  url         String
  fileSize    BigInt?

  changes     String?  @db.Text
  createdBy   String?

  createdAt   DateTime @default(now())

  @@unique([videoId, version])
  @@index([videoId])
  @@map("video_versions")
}

model Clip {
  id          String   @id @default(uuid())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  title       String
  description String?

  url         String
  thumbnailUrl String?

  startTime   Float    // seconds
  endTime     Float
  duration    Float

  // AI Analysis
  viralScore  Int?     // 0-100
  category    String?
  emotions    Json?
  keyMoments  Json?

  createdAt   DateTime @default(now())

  @@index([videoId])
  @@map("clips")
}

model Asset {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  name        String
  type        AssetType

  url         String
  thumbnailUrl String?

  size        BigInt?     @default(0)
  duration    Float?      // For video/audio
  fileSize    BigInt?
  mimeType    String?

  // Organization
  folderId    String?
  tags        String[]
  collections String[]    // Collection IDs this asset belongs to

  // AI Generation
  aiGenerated Boolean     @default(false)
  generationSettings Json?

  // Usage tracking
  usageCount  Int         @default(0)

  metadata    Json?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@map("assets")
}

enum AssetType {
  VIDEO
  IMAGE
  AUDIO
  SUBTITLE
  FONT
  PRESET
  TEMPLATE
  EFFECT
  MODEL
  OTHER
}

// ============================================================================
// FLOW STUDIO FEATURES (Google Flow-style)
// ============================================================================

model Storyboard {
  id            String   @id @default(uuid())
  projectId     String
  userId        String

  name          String
  scenes        Json     // Array of Scene objects
  totalDuration Int      @default(0) // milliseconds
  aspectRatio   String   @default("16:9")
  resolution    String   @default("1080p")
  frameRate     Int      @default(24)

  metadata      Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("storyboards")
}

model Timeline {
  id                String   @id @default(uuid())
  projectId         String
  userId            String

  name              String
  tracks            Json     // Array of TimelineTrack objects
  duration          Int      @default(0) // milliseconds
  zoom              Float    @default(1.0)
  playheadPosition  Int      @default(0)

  settings          Json?    // resolution, frameRate, aspectRatio, etc.

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("timelines")
}

model Collection {
  id          String   @id @default(uuid())
  userId      String

  name        String
  description String?
  assetIds    String[] // References to Asset IDs
  color       String?
  icon        String?
  shared      Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("collections")
}

model Comment {
  id                String   @id @default(uuid())
  projectId         String
  userId            String
  userName          String

  text              String   @db.Text
  timelinePosition  Int?     // milliseconds on timeline
  clipId            String?

  resolved          Boolean  @default(false)
  replies           Json?    // Array of reply comments

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("comments")
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String

  version     Int
  name        String
  description String?
  userId      String

  snapshot    Json     // Complete project state

  createdAt   DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId])
  @@map("project_versions")
}

// ============================================================================
// JOB QUEUE & PROCESSING
// ============================================================================

model Job {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId       String?
  video         Video?      @relation(fields: [videoId], references: [id], onDelete: SetNull)

  type          JobType
  status        JobStatus   @default(QUEUED)
  priority      Int         @default(0) // Higher = more priority

  // Job Data
  input         Json
  output        Json?
  error         String?     @db.Text
  errorCode     String?

  // Progress
  progress      Int         @default(0) // 0-100
  currentStep   String?
  totalSteps    Int?
  estimatedTime Int?        // seconds

  // Processing
  provider      String?
  model         String?
  workerId      String?     // Which worker is processing

  // Timing
  queuedAt      DateTime    @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  canceledAt    DateTime?

  // Retry Logic
  attempts      Int         @default(0)
  maxAttempts   Int         @default(3)
  nextRetryAt   DateTime?

  // Cost
  creditsRequired Int?
  creditsCharged  Int?

  // Metadata
  metadata      Json?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([queuedAt])
  @@index([provider])
  @@map("jobs")
}

enum JobType {
  VIDEO_GENERATION
  VIDEO_PROCESSING
  VIDEO_TRANSLATION
  VIDEO_TRANSCRIPTION
  HIGHLIGHT_EXTRACTION
  STORYBOARD_GENERATION
  MULTIVERSE_GENERATION
  VIDEO_OPTIMIZATION
  VIDEO_TRANSCODING
  SOCIAL_MEDIA_PUBLISH
  THUMBNAIL_GENERATION
  SUBTITLE_GENERATION
  VOICE_CLONING
  AUDIO_GENERATION
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
  RETRYING
  PAUSED
}

// ============================================================================
// NEXUS PLATFORM - POST-FEED ERA FEATURES
// ============================================================================

// Personal Digital Twin (PDT)
model PersonalDigitalTwin {
  id                String   @id @default(uuid())
  userId            String   @unique

  // Configuration
  modelName         String   @default("llama-4-7b") // Local LLM
  personality       Json?    // Personality traits
  privacySettings   Json?    // Privacy preferences

  // Memory
  localCollectionId String   // Chroma DB collection
  cloudCollectionId String?  // Pinecone collection (optional)
  syncEnabled       Boolean  @default(false)
  documentCount     Int      @default(0)

  // Goals (Stated vs Revealed)
  statedGoals       Json     // Primary goals user explicitly sets
  avoidTopics       String[] // Topics to filter out
  prioritizeTopics  String[] // Topics to prioritize

  // Performance Metrics
  contentFiltered   Int      @default(0)
  slopBlocked       Int      @default(0)
  goalAlignment     Float    @default(0.0) // 0-1

  // Settings
  maxDailyScreenTime Int?    // minutes
  focusHours        Json?    // Array of time ranges

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("personal_digital_twins")
}

// Agent-to-Agent Collaboration
model AgentCollaboration {
  id                  String   @id
  initiatorUserId     String
  participantUserIds  String[] // Array of participant user IDs

  goal                String   @db.Text
  context             Json?

  status              String   @default("pending") // pending, negotiating, completed, failed
  result              Json?    // Collaboration result
  messages            Json     @default("[]") // Array of collaboration messages

  createdAt           DateTime @default(now())
  completedAt         DateTime?

  @@index([initiatorUserId])
  @@index([status])
  @@map("agent_collaborations")
}

// Generative UI
model GeneratedUI {
  id              String   @id
  userId          String
  conversationId  String

  components      Json     // Array of UI components
  layout          String   // stack, grid, sidebar, fullscreen, floating
  theme           String?  @default("light")

  metadata        Json     // confidence, reasoning, generatedAt

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([conversationId])
  @@map("generated_uis")
}

// Spatial Worlds
model SpatialWorld {
  id              String   @id
  name            String
  description     String?  @db.Text
  creatorId       String

  sceneData       Json     // Environment, objects, audio
  participants    Json     @default("[]") // Array of participants with avatars
  settings        Json     // maxParticipants, isPublic, physics, etc.

  status          String   @default("ready") // generating, ready, active, archived

  createdAt       DateTime @default(now())
  lastActiveAt    DateTime @default(now())

  @@index([creatorId])
  @@index([status])
  @@map("spatial_worlds")
}

// Avatars
model Avatar {
  id          String   @id
  userId      String   @unique

  modelUrl    String   // URL to 3D avatar model
  textureUrl  String?
  animations  Json     // idle, walk, talk, gesture animations
  voice       Json?    // voiceId, pitch, speed

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("avatars")
}

// Translation Sessions
model TranslationSession {
  id            String   @id
  participants  Json     // Array of {userId, language, voiceProfile}

  status        String   @default("active") // active, paused, ended
  messages      Json     @default("[]") // Translation messages

  createdAt     DateTime @default(now())
  endedAt       DateTime?

  @@index([status])
  @@map("translation_sessions")
}

// Voice Profiles
model VoiceProfile {
  id                String   @id
  userId            String   @unique

  voiceId           String   // ElevenLabs voice ID
  samples           String[] // URLs to voice samples
  characteristics   Json     // pitch, speed, tone, accent

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("voice_profiles")
}

model VoiceTranslation {
  id                String   @id @default(uuid())
  userId            String
  sessionId         String?

  sourceLanguage    String
  targetLanguage    String
  sourceText        String   @db.Text
  translatedText    String   @db.Text

  latency           Int      // milliseconds
  confidence        Float
  voiceCloned       Boolean  @default(false)

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@map("voice_translations")
}

model UserAudioSample {
  id          String   @id @default(uuid())
  userId      String

  audioUrl    String
  duration    Float?   // seconds

  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("user_audio_samples")
}

// Trust & Verification
model TrustScore {
  id                  String   @id @default(uuid())
  userId              String   @unique

  overall             Float    // 0-1
  components          Json     // verifiedIdentity, contentAuthenticity, etc.

  lastUpdated         DateTime @default(now())

  @@map("trust_scores")
}

model VerifiableCredential {
  id              String   @id
  type            String[] // Array of credential types

  issuerDid       String
  subjectDid      String

  credentialData  Json     // Full credential object

  issuanceDate    DateTime
  expirationDate  DateTime?

  createdAt       DateTime @default(now())

  @@index([subjectDid])
  @@index([issuerDid])
  @@map("verifiable_credentials")
}

model TrustAttestation {
  id            String   @id
  fromUserId    String
  toUserId      String

  type          String   // trust, distrust
  category      String   @default("general") // general, expertise, fact-checking
  weight        Float    @default(1.0)
  reason        String?  @db.Text

  createdAt     DateTime @default(now())
  expiresAt     DateTime?

  @@index([fromUserId])
  @@index([toUserId])
  @@map("trust_attestations")
}

model CommunityNote {
  id            String   @id
  contentId     String
  authorId      String

  text          String   @db.Text
  rating        String   // helpful, not-helpful, misleading
  evidence      String[] // URLs to evidence

  votesHelpful    Int    @default(0)
  votesNotHelpful Int    @default(0)

  status        String   @default("pending") // pending, approved, rejected

  createdAt     DateTime @default(now())

  @@index([contentId])
  @@index([authorId])
  @@index([status])
  @@map("community_notes")
}

model UserContent {
  id            String   @id @default(uuid())
  userId        String

  contentType   String   // post, video, image, etc.
  contentUrl    String?
  contentData   Json?

  c2paManifest  Json?    // C2PA content provenance manifest

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("user_content")
}

model UserAction {
  id          String   @id @default(uuid())
  userId      String

  actionType  String   // like, comment, share, etc.
  targetType  String   // post, video, user, etc.
  targetId    String

  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([actionType])
  @@map("user_actions")
}

// ActivityPub Federation
model FederatedPost {
  id              String   @id
  authorActorId   String   // Actor ID (URL) of author

  content         String   @db.Text
  contentHtml     String?  @db.Text

  publishedAt     DateTime
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([authorActorId])
  @@index([publishedAt])
  @@map("federated_posts")
}

model FederatedLike {
  id          String   @id @default(uuid())
  actorId     String   // Actor ID who liked
  objectId    String   // Object ID that was liked

  createdAt   DateTime @default(now())

  @@unique([actorId, objectId])
  @@index([actorId])
  @@index([objectId])
  @@map("federated_likes")
}

model FederatedAnnounce {
  id          String   @id @default(uuid())
  actorId     String   // Actor ID who announced
  objectId    String   // Object ID that was announced

  createdAt   DateTime @default(now())

  @@unique([actorId, objectId])
  @@index([actorId])
  @@index([objectId])
  @@map("federated_announces")
}

model Follow {
  id                String   @id @default(uuid())
  followerActorId   String   // Actor ID of follower
  followingUsername String?  // Local username (if following local user)
  followingActorId  String?  // Actor ID (if following remote user)

  status            String   @default("pending") // pending, accepted, rejected

  createdAt         DateTime @default(now())

  @@unique([followerActorId, followingUsername])
  @@unique([followerActorId, followingActorId])
  @@index([followerActorId])
  @@index([followingUsername])
  @@index([followingActorId])
  @@map("follows")
}

