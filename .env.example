# ============================================================================
# NEURAFIELD QUANTUM - ENVIRONMENT VARIABLES
# ============================================================================

# Application
NODE_ENV=development
PORT=3000
DOMAIN=localhost:3000
CLIENT_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/neurafield

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Auth
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# Video Generation APIs (9 Providers - Latest Models)
KLING_API_KEY=...              # Kling AI v1.5 (Kuaishou)
GOOGLE_AI_API_KEY=...           # Veo 3.1 (Google DeepMind)
RUNWAY_API_KEY=...              # Runway Gen-3 Alpha
LUMA_API_KEY=...                # Luma Dream Machine 1.5
PIKA_API_KEY=...                # Pika 1.5
HIGGSFIELD_API_KEY=...          # Higgsfield AI (Diffuse & Lotus)
HAIPER_API_KEY=...              # Haiper AI 2.0
GENMO_API_KEY=...               # Genmo Mochi 1 (Open Source)
REPLICATE_API_KEY=r8_...        # Replicate (multiple models)
FAL_KEY=...                     # fal.ai (fast inference)
MESHY_API_KEY=...               # Meshy5 (3D generation)

# AWS
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=neurafield-uploads
AWS_CLOUDFRONT_URL=https://d1234567890.cloudfront.net

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# SendGrid
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@neurafield.ai
SENDGRID_FROM_NAME=Neurafield Quantum

# Platform (for ActivityPub)
PLATFORM_DID=neurafield
PLATFORM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Google APIs (for OAuth, Maps, etc.)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# GitHub OAuth
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# Discord OAuth
DISCORD_CLIENT_ID=...
DISCORD_CLIENT_SECRET=...

# Twitter OAuth
TWITTER_CLIENT_ID=...
TWITTER_CLIENT_SECRET=...

# Monitoring (optional)
SENTRY_DSN=https://...@sentry.io/...
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_ACTIVITYPUB=true
ENABLE_VOICE_TRANSLATION=true

# Development
DEBUG=false
ENABLE_PLAYGROUND=false
