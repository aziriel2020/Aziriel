# ============================================
# SKYWARD TRAVELS - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_NAME=Skyward Travels
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK (Server-side)
# Download service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# ============================================
# DATABASE (PostgreSQL via Prisma)
# ============================================
# For production, use a managed PostgreSQL (Supabase, Neon, PlanetScale, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/skyward_travels?schema=public"
DATABASE_POOL_URL="postgresql://user:password@localhost:5432/skyward_travels?schema=public&pgbouncer=true"

# ============================================
# REDIS (Caching & Queue)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Password hashing
BCRYPT_SALT_ROUNDS=12

# ============================================
# AMADEUS GDS API (Flight Search)
# ============================================
# Get credentials at: https://developers.amadeus.com
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENVIRONMENT=test
# Use 'production' for live bookings

# ============================================
# DUFFEL API (Alternative Flight Provider)
# ============================================
# Get credentials at: https://duffel.com/docs
DUFFEL_ACCESS_TOKEN=duffel_test_your_access_token
DUFFEL_ENVIRONMENT=sandbox
# Use 'live' for production

# ============================================
# HOTELBEDS API (Hotel Search & Booking)
# ============================================
# Get credentials at: https://developer.hotelbeds.com
HOTELBEDS_API_KEY=your_hotelbeds_api_key
HOTELBEDS_SECRET=your_hotelbeds_secret
HOTELBEDS_ENVIRONMENT=test
# Use 'production' for live bookings

# ============================================
# STRIPE (Payments)
# ============================================
# Get credentials at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=USD

# ============================================
# OPENAI (AI Features)
# ============================================
# Get API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# ============================================
# ANTHROPIC (AI Features)
# ============================================
# Get API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# AWS S3 (File Storage)
# ============================================
# Optional: Use if not using Firebase Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=skyward-travels-uploads

# ============================================
# EMAIL (SendGrid / Resend)
# ============================================
EMAIL_PROVIDER=sendgrid
# Options: sendgrid, resend, ses

# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Resend (alternative)
RESEND_API_KEY=re_your_resend_api_key

# Email Configuration
EMAIL_FROM_ADDRESS=noreply@skywardtravels.com
EMAIL_FROM_NAME=Skyward Travels
EMAIL_SUPPORT_ADDRESS=support@skywardtravels.com

# ============================================
# SMS (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ============================================
FCM_SERVER_KEY=your_fcm_server_key

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# LogRocket (Session Replay)
NEXT_PUBLIC_LOGROCKET_APP_ID=your-org/your-app

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SECURITY
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://skywardtravels.com
ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_CHAT=true
FEATURE_PRICE_ALERTS=true
FEATURE_LOYALTY_PROGRAM=true
FEATURE_MULTI_CITY=true
FEATURE_FLIGHT_BUNDLES=true

# ============================================
# ENVIRONMENT SPECIFIC
# ============================================
# For Firebase Functions
FUNCTIONS_EMULATOR=false

# For local development
LOCAL_DEV=true
DEBUG=false
