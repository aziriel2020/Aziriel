# ============================================================================
# NEURAFIELD QUANTUM - ENVIRONMENT VARIABLES
# ============================================================================

# Application
NODE_ENV=development
PORT=3000
DOMAIN=localhost:3000
CLIENT_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/neurafield

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Auth
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
REPLICATE_API_KEY=r8_...
FAL_KEY=...
MESHY_API_KEY=...

# AWS
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=neurafield-uploads
AWS_CLOUDFRONT_URL=https://d1234567890.cloudfront.net

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# SendGrid
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@neurafield.ai
SENDGRID_FROM_NAME=Neurafield Quantum

# Platform (for ActivityPub)
PLATFORM_DID=neurafield
PLATFORM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Google APIs (for OAuth, Maps, etc.)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# GitHub OAuth
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# Discord OAuth
DISCORD_CLIENT_ID=...
DISCORD_CLIENT_SECRET=...

# Twitter OAuth
TWITTER_CLIENT_ID=...
TWITTER_CLIENT_SECRET=...

# Monitoring (optional)
SENTRY_DSN=https://...@sentry.io/...
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_ACTIVITYPUB=true
ENABLE_VOICE_TRANSLATION=true

# Development
DEBUG=false
ENABLE_PLAYGROUND=false
