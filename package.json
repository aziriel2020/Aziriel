{
  "name": "skyward-travels",
  "version": "1.0.0",
  "description": "Trillion Dollar Hotel + Flight Booking Platform - Complete Production System",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:client && npm run build:functions",
    "build:client": "npm --prefix client run build",
    "build:functions": "npm --prefix functions run build",
    "start": "npm run start:prod",
    "start:prod": "NODE_ENV=production ts-node --transpile-only server/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init",
    "firebase:emulators": "firebase emulators:start",
    "firebase:emulators:ui": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "firebase:deploy": "npm run build && firebase deploy",
    "firebase:deploy:hosting": "npm run build:client && firebase deploy --only hosting",
    "firebase:deploy:functions": "npm run build:functions && firebase deploy --only functions",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:deploy:all": "npm run build && firebase deploy --only hosting,functions,firestore,storage",
    "firebase:preview": "firebase hosting:channel:deploy preview --expires 7d",
    "deploy:staging": "firebase use staging && npm run firebase:deploy",
    "deploy:production": "firebase use production && npm run firebase:deploy",
    "docker:build": "docker build -t skyward-travels .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "postinstall": "npm --prefix client install && npm --prefix functions install"
  },
  "keywords": [
    "travel",
    "booking",
    "flights",
    "hotels",
    "firebase",
    "nextjs",
    "typescript",
    "amadeus",
    "duffel",
    "hotelbeds"
  ],
  "author": "Skyward Travels",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/lib-storage": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@prisma/client": "^5.19.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "openai": "^4.52.0",
    "stripe": "^16.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "firebase-tools": "^13.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "prisma": "^5.19.0",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
